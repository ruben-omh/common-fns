	"scripts": {
		"typecheck": "tsc -b --noEmit",
		"dts": "lazyconfig compile types --tsc tsconfig.lib.json --aec api-extractor.*.json --ext mts cts",
		"build": "pnpm dts && rollup --config",
		"dev": "tsc -p tsconfig.lib.json --watch",
		"clean": "rimraf out-tsc dist coverage reports tsconfig.*.tsbuildinfo .turbo",
		"clean:reset": "pnpm clean && rimraf node_modules",
		"test": "jest"
	},
	"devDependencies": {
