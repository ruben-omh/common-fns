	"exports": {
		".": {
			"types": "./dist/common-fns.js.index.d.ts",
			"import": {
				"types": "./dist/common-fns.js.index.d.mts",
				"default": "./dist/common-fns.js.index.min.mjs"
			},
			"require": {
				"types": "./dist/common-fns.js.index.d.cts",
				"default": "./dist/common-fns.js.index.min.cjs"
			}
		},
		"./array": {
			"types": "./dist/common-fns.js.array.d.ts",
